package main

import (
	"fmt"
	"strings"

	"github.com/traust-security/traust-sdk/go/v1/traust"
)

// htmx swaps error responses too, so a refusal shows where its request was made.
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"...","swap":true}]}`

// tally is one row of a count: a label and its number, as core answered them.
type tally struct {
	Label string
	Count string
}

// card is one dashboard query's answer.
type card struct {
	Title string
	Rows  []tally
}

// restatements are why a person may restate a decision.
var restatements = []traust.RestatementReason{traust.OperatorError, traust.DataError, traust.BaselineRewrite}

// validities are the answers a person may give about a finding.
var validities = []traust.Validity{traust.ValidityConfirmed, traust.ValidityFalsePositive, traust.ValidityHardening, traust.ValidityNotAffected}

templ page(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>{ title }</title>
			<meta name="htmx-config" content={ htmxConfig }/>
			<script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<nav><a class="brand" href="/">ᛏ traust</a><a href="/onboard">Onboard</a><a href="/review">Review</a></nav>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

templ signIn(problem string) {
	@page("Sign in to traust") {
		<form method="post" action="/sign-in">
			<label>Your traust token <input type="password" name="token" required autofocus/></label>
			<button>Sign in</button>
			if problem != "" {
				<p role="alert">{ problem }</p>
			}
		</form>
	}
}

templ home(me traust.Principal, repos []traust.Repository, cards []card) {
	@page("traust") {
		<header>
			Signed in as { me.Display }
			<form method="post" action="/sign-out"><button>Sign out</button></form>
		</header>
		<div class="cards">
		for _, c := range cards {
			<section>
				<h2>{ c.Title }</h2>
				if len(c.Rows) == 0 {
					<p>Nothing yet.</p>
				}
				<dl>
					for _, row := range c.Rows {
						<dt>{ row.Label }</dt>
						<dd>{ row.Count }</dd>
					}
				</dl>
			</section>
		}
		</div>
		<section>
			<h2>Repositories</h2>
			if len(repos) == 0 {
				<p>Nothing onboarded yet. <a href="/onboard">Onboard a repository.</a></p>
			}
			<ul>
				for _, repo := range repos {
					<li><a href={ templ.URL("/repositories/" + repo.Id.String()) }>{ repo.Url }</a></li>
				}
			</ul>
		</section>
		<section>
			<h2>Reports</h2>
			<button hx-post="/reports" hx-vals={ `{"report":"findings-rollup"}` } hx-target="#reports" hx-swap="afterbegin">Build the findings rollup</button>
			<ul id="reports"></ul>
		</section>
	}
}

templ onboardForm() {
	@page("Onboard") {
		<h1>Onboard repositories</h1>
		<form hx-post="/onboard/plan" hx-target="#plan">
			<label>Product <input name="product" required placeholder="payments"/></label>
			<label>Label <input name="label" placeholder="Payments (new products only)"/></label>
			<label>Repository URLs, one per line <textarea name="repositories" rows="4" required></textarea></label>
			<button>Preview</button>
		</form>
		<div id="plan"></div>
		<p>The engine schedules a scan of each new repository on its next pass; a repository's page runs one now.</p>
	}
}

templ onboardPlan(plan traust.OnboardingPlan) {
	<section>
		<h2>What onboarding will do</h2>
		<ul>
			for _, spec := range items(plan.New) {
				<li>register { spec.Url }</li>
			}
			for _, id := range items(plan.ExistingRepositoryIds) {
				<li>refresh repository { id.String() }</li>
			}
			for _, gap := range items(plan.Gaps) {
				<li role="alert">{ gap.Subject }: { gap.Reason }</li>
			}
		</ul>
		if len(items(plan.Gaps)) == 0 {
			<button hx-post="/onboard" hx-include="body form">Onboard</button>
		}
	</section>
}

templ repository(repo traust.Repository, ref *traust.RepositoryRef) {
	@page(repo.Url) {
		<h1>{ repo.Url }</h1>
		if ref != nil {
			<p>Default branch { text(ref.Name) } at { ref.Sha }</p>
		}
		for _, asset := range []string{"scan", "triage"} {
			<button hx-post="/runs" hx-vals={ `{"asset":"` + asset + `","repository_id":"` + repo.Id.String() + `"}` } hx-target="#runs" hx-swap="afterbegin">Run { asset }</button>
		}
		<ul id="runs"></ul>
		<h2>Run history</h2>
		<div hx-get={ "/repositories/" + repo.Id.String() + "/runs" } hx-trigger="load, run-finished from:body"></div>
		<h2>Findings</h2>
		<div hx-get={ "/repositories/" + repo.Id.String() + "/findings" } hx-trigger="load, run-finished from:body"></div>
		<h2>Ledger</h2>
		<div id="ledger" hx-get={ "/repositories/" + repo.Id.String() + "/ledger" } hx-trigger="load"></div>
	}
}

// ledger is the repository's proof chain: decisions as Merkle layers, signed when a key is set.
templ ledger(repo string, layers []traust.Layer) {
	<div id="ledger">
		if len(layers) == 0 {
			<p>No decisions recorded yet.</p>
		}
		<ul>
			for _, l := range layers {
				<li>
					{ text(l.Line) } layer: { fmt.Sprint(value(l.MerkleSize)) } events, root { short(l.MerkleRoot) },
					if l.MerkleRootSignature != nil {
						signed
					} else {
						unsigned
					}
					<button hx-post={ "/layers/" + l.Id.String() + "/verify" } hx-target="next .verdict">Verify</button>
					<span class="verdict"></span>
				</li>
			}
		</ul>
		<button hx-post={ "/repositories/" + repo + "/checkpoint" } hx-target="#ledger" hx-swap="outerHTML">Checkpoint (admins)</button>
	</div>
}

templ verified(result traust.VerifyResult) {
	if result.Passed != nil && *result.Passed {
		<span class="verdict">verified</span>
	} else {
		<span class="verdict" role="alert">failed: { strings.Join(items(result.Errors), "; ") }</span>
	}
}

templ findingList(findings []traust.FindingView) {
	if len(findings) == 0 {
		<p>No findings yet. Run a scan.</p>
	}
	<ul>
		for _, f := range findings {
			<li>
				<a href={ templ.URL("/findings/" + f.Finding.Id.String()) }>{ f.Finding.Title }</a>
				<span class={ "sev", severity(f.EffectiveSeverity) }>{ severity(f.EffectiveSeverity) }</span> · { validity(f.Disposition) }
			</li>
		}
	</ul>
}

templ finding(f traust.FindingView, decisions []traust.Decision) {
	@page(f.Finding.Title) {
		<h1>{ f.Finding.Title }</h1>
		<p><span class={ "sev", severity(f.EffectiveSeverity) }>{ severity(f.EffectiveSeverity) }</span> · { validity(f.Disposition) }</p>
		if f.Description != nil {
			<p>{ *f.Description }</p>
		}
		@decideForm(f)
		<h2>Decisions</h2>
		<ol>
			for _, d := range decisions {
				<li>
					{ decisionValidity(d) } by { text(d.Actor) }: { text(d.Rationale) }
					if d.RestatesId != nil {
						(restates an earlier decision)
					}
				</li>
			}
		</ol>
		if len(decisions) > 0 {
			@restateForm(decisions[len(decisions)-1])
		}
	}
}

// restateForm corrects a recorded decision with a reason and a ticket; core keeps both.
templ restateForm(d traust.Decision) {
	<form id="restate" hx-post={ "/decisions/" + d.Id.String() + "/restate" } hx-swap="outerHTML">
		<h2>Restate the latest decision</h2>
		<label>
			Correct its validity to
			<select name="validity">
				for _, val := range validities {
					<option value={ string(val) }>{ string(val) }</option>
				}
			</select>
		</label>
		<select name="reason">
			for _, r := range restatements {
				<option value={ string(r) }>{ string(r) }</option>
			}
		</select>
		<label>Ticket <input name="ticket" required placeholder="SEC-123"/></label>
		<label>Rationale <textarea name="rationale" required></textarea></label>
		<button>Restate</button>
	</form>
}

templ restated() {
	<p id="restate">Restated. <a href="">Reload</a> to see the history.</p>
}

// review is the countersign queue: machine verdicts and conflicts a person settles.
templ review(cases []traust.ReviewCase) {
	@page("Review") {
		<h1>Review</h1>
		if len(cases) == 0 {
			<p>Nothing waits on you.</p>
		}
		<ul>
			for _, c := range cases {
				<li>
					<a href={ templ.URL("/findings/" + c.FindingId.String()) }>{ caseTitle(c) }</a>
					{ string(c.Kind) } · { validity(c.Disposition) }
				</li>
			}
		</ul>
	}
}

templ decideForm(f traust.FindingView) {
	<form id="decide" hx-post={ "/findings/" + f.Finding.Id.String() + "/decide" } hx-swap="outerHTML">
		<h2>Decide</h2>
		<select name="validity">
			for _, v := range validities {
				<option value={ string(v) }>{ string(v) }</option>
			}
		</select>
		<label>Rationale <textarea name="rationale" required></textarea></label>
		<button>Record the decision</button>
	</form>
}

templ decided() {
	<p id="decide">Decision recorded. <a href="">Reload</a> to see the finding's new state.</p>
}

// runHistory is what ran for a repository and who asked: a person, or the engine on its trigger.
templ runHistory(orders []traust.RunOrder) {
	if len(orders) == 0 {
		<p>No runs yet.</p>
	}
	<ul>
		for _, o := range orders {
			<li>{ o.Asset }: { string(o.State) }, requested by { o.RequestedBy }</li>
		}
	</ul>
}

// job is work core finishes later: until done, the row asks poll for itself every second.
templ job(poll string, done bool) {
	if done {
		<li>{ children... }</li>
	} else {
		<li hx-get={ poll } hx-trigger="every 1s" hx-swap="outerHTML">{ children... }…</li>
	}
}

templ runRow(token string, state traust.RunOrderState, done bool) {
	@job("/runs/"+token, done) {
		run { token }: { string(state) }
	}
}

templ reportRow(token string, report traust.Report, done bool) {
	@job("/reports/"+token, done) {
		{ string(report.Report) } report: { string(report.Status) }
		if report.Status == traust.ReportStatusReady {
			<a href={ templ.URL("/reports/" + token + "/file") } download>download</a>
		}
	}
}

templ failure(message string) {
	<p role="alert">{ message }</p>
}
