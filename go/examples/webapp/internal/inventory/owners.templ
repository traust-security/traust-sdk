package inventory

import (
	"github.com/traust-security/traust-sdk/go/v1/traust"

	"github.com/traust-security/traust-sdk/go/examples/webapp/internal/web"
)

// ownerList is a repository page's lazy owners section: the teams owning it now, each linking to
// its page. The section re-lists after the admin action.
templ ownerList(repo string, teams []traust.Team) {
	<div id="owners">
		if len(teams) == 0 {
			<p>No owners known yet.</p>
		}
		<ul>
			for _, team := range teams {
				<li><a href={ templ.URL("/teams/" + team.Id.String()) }>{ team.Name }</a></li>
			}
		</ul>
		@ownerForm(repo)
	</div>
}

// ownerForm sets a repository's owners; core decides who may.
templ ownerForm(repo string) {
	<form hx-post={ "/repositories/" + repo + "/owners" } hx-target="#owners" hx-swap="outerHTML">
		<h3>Set owners</h3>
		<label>Teams, one per line <textarea name="teams" rows="2" required placeholder="payments"></textarea></label>
		<button>Set</button>
	</form>
}

// teamDetail is a team's page: the repositories it owns now, each as core words it.
templ teamDetail(repos []traust.Repository) {
	@web.Page("A team") {
		<h1>The team's repositories</h1>
		if len(repos) == 0 {
			<p>None owned now.</p>
		}
		<ul>
			for _, repo := range repos {
				<li><a href={ templ.URL("/repositories/" + repo.Id.String()) }>{ repo.Url }</a></li>
			}
		</ul>
	}
}
